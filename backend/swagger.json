{
  "openapi": "3.0.0",
  "info": {
    "title": "EPWX Public Supply API",
    "version": "1.0.0",
    "description": "Public endpoints for real-time, on-chain EPWX token supply data. Successful responses contain only a JSON numerical value, as required by CoinMarketCap Annex C. Base URL: https://api.epowex.com/api"
  },
  "servers": [
    { "url": "https://api.epowex.com/api" }
  ],
  "paths": {
    "/supply": {
      "get": {
        "summary": "Get total supply net of burns",
        "description": "Returns the contract total supply minus the verifiably burned dead-wallet balance.",
        "responses": {
          "200": {
            "description": "Total supply response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "number",
                  "example": 31636112613662.907941756
                }
              }
            }
          }
        }
      }
    },
    "/circulating": {
      "get": {
        "summary": "Get circulating supply",
        "description": "Returns the circulating supply (total supply minus burned and treasury-locked tokens).",
        "responses": {
          "200": {
            "description": "Circulating supply response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "number",
                  "example": 31534662490294.9022976
                }
              }
            }
          }
        }
      }
    },
    "/burned": {
      "get": {
        "summary": "Get burned supply",
        "description": "Returns the total amount of EPWX sent to the burn (dead) address.",
        "responses": {
          "200": {
            "description": "Burned supply response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "number",
                  "example": 468363887386337.092058244
                }
              }
            }
          }
        }
      }
    }
  }
}
